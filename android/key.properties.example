# Template for android/key.properties (the real file is NEVER committed).
# Copy it to android/key.properties and fill in the values.
# In CI, GitHub Actions writes key.properties from the GitHub Secrets.

# Keystore path, relative to android/app/
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
