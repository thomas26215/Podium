rules_version = '2';

// Security rules for Podium.
//
// Deploy with: firebase deploy --only firestore:rules
// (after `firebase init firestore` / `firebase use <your-project>`).
//
// Data model recap:
//   users/{uid}                        one doc per account
//   guests/{guestId}                   one doc per account-less player, added
//                                       into `memberIds` as a `guest:{guestId}`
//                                       string (see GuestsRepository)
//   emailIndex/{lowercasedEmail}        {uid} — lets "invite by email" find a uid
//   groups/{groupId}                   a friend group
//   groups/{groupId}/games/{gameId}    game catalog
//   groups/{groupId}/matches/{matchId} recorded matches
//   groups/{groupId}/tournaments/{id}  a bracket (single/double elimination or
//                                       groups+elimination) — the whole bracket
//                                       (every match node) lives embedded in
//                                       this one document
//   groups/{groupId}/messages/{id}     the group's discussion thread — a
//                                       plain message, a poll ("quel jeu ce
//                                       soir ?" — see pollGameIds/pollVotes),
//                                       or a system highlight (authorId
//                                       'system', posted by onMatchCreated)
//   servers/{serverId}                 a rigid community (e.g. a game café) —
//                                       unlike a group, only the owner/admins
//                                       manage the catalog and salons
//   servers/{serverId}/salons/{id}     a room within a server (e.g. a weekly
//                                       tournament) — its own membership,
//                                       separate from the server's
//   servers/{serverId}/games/{gameId}  game catalog, shared by every salon of
//                                       this server
//   servers/{serverId}/matches/{id}    recorded matches, each tagged with the
//                                       salon it was played in (`salonId`) —
//                                       stay 'pending' (see GameMatch.status,
//                                       computed client-side from confirmedBy/
//                                       rejectedBy — nothing here depends on
//                                       it) until every human player involved
//                                       confirms
//   servers/{serverId}/messages/{id}   discussion thread, shared by the whole
//                                       server's `messages` collection but
//                                       each doc tagged with the salon it was
//                                       posted in (`salonId`)

service cloud.firestore {
match /databases/{database}/documents {

  function signedIn() {
    return request.auth != null;
  }

  function isMember(groupData) {
    return request.auth.uid in groupData.memberIds;
  }

  function groupDoc(groupId) {
    return get(/databases/$(database)/documents/groups/$(groupId));
  }

  // True if the caller owns group `groupId` — used to gate destructive
  // actions (deleting the group, its games/matches, …).
  function isGroupOwner(groupId) {
    return groupDoc(groupId).data.ownerId == request.auth.uid;
  }

  // True for a wound-down "temporary group" (see Group.closed) — its
  // history stays readable but nothing new gets recorded in it.
  function isClosed(groupData) {
    return groupData.get('closed', false) == true;
  }

  // True while `groupData`'s QR self-join window is open (see
  // Group.inviteExpiresAt / GroupsRepository.refreshInviteWindow, refreshed
  // every time the invite dialog's QR tab is shown). A group that has never
  // opened a window (the field is simply absent — every group created before
  // this existed, or one that's never shown its QR tab) stays joinable
  // unconditionally, so this only ever *tightens* behavior for groups that
  // opt in by generating a code, never breaks existing ones on deploy.
  function inviteWindowOpen(groupData) {
    return !('inviteExpiresAt' in groupData) || request.time < groupData.inviteExpiresAt;
  }

  // True if this update only adds the caller's own uid to `memberIds`
  // (nothing else touched) — the shape of a self-service QR invite join.
  // It's a write-only check: a non-member can perform it without ever being
  // able to `read` the doc first, since the QR code itself already carries
  // everything the client needs (see GroupInviteCode). Also requires the
  // invite window to still be open, so a screenshot/photo of an old code
  // can't be replayed forever — see inviteWindowOpen().
  function isSelfJoin(before) {
    let addedMembers = request.resource.data.memberIds.removeAll(before.memberIds);
    return request.resource.data.diff(before).affectedKeys().hasOnly(['memberIds'])
      && request.resource.data.memberIds.removeAll([request.auth.uid]) == before.memberIds
      && addedMembers.size() > 0
      && inviteWindowOpen(before)
      && !isClosed(before);
  }

  // True if this update on a group is something any plain member may do:
  // invite someone (add to `memberIds`), leave (remove themselves), swap a
  // guest out for a real account (remove one `guest:` id — see
  // AppState.reassignMember), or reopen the QR invite window. Ownership,
  // closing/reopening and kicking another real account stay owner-only (see
  // the `groups/{groupId}` update rule).
  function isMemberGroupEdit(before) {
    let removed = before.memberIds.removeAll(request.resource.data.memberIds);
    return request.resource.data.diff(before).affectedKeys().hasOnly(['memberIds', 'inviteExpiresAt'])
      && removed.size() <= 1
      && (removed.size() == 0 || removed[0] == request.auth.uid || removed[0].matches('guest:.*'));
  }

  // True if this update on a poll message (see GroupMessage.pollGameIds in
  // lib/models/message.dart) only touches the caller's own entry in
  // `pollVotes`, and only to a valid option — the shape of a member casting
  // or changing their ballot (see AppState.voteInPoll). A write-only check,
  // same spirit as isSelfJoin(): whoever's voting need not be the message's
  // author.
  function isPollVote(before) {
    return request.resource.data.diff(before).affectedKeys().hasOnly(['pollVotes'])
      && before.get('pollGameIds', []).size() > 0
      && request.resource.data.pollVotes.diff(before.get('pollVotes', {})).affectedKeys().hasOnly([request.auth.uid])
      && request.resource.data.pollVotes[request.auth.uid] in before.pollGameIds;
  }

  // True if this update on a message only changes its `text` (and sets
  // `edited: true`) — the shape of AppState.editMessage. Author-only:
  // unlike a poll vote, editing someone else's message is never allowed.
  function isMessageEdit(before) {
    return request.auth.uid == before.authorId
      && request.resource.data.diff(before).affectedKeys().hasOnly(['text', 'edited'])
      && request.resource.data.edited == true;
  }

  // True if this update only touches the caller's own entry in
  // `reactions` — the shape of AppState.reactToMessage (setting or, tapping
  // the same emoji again, clearing their reaction). Any value is a valid
  // emoji, so unlike isPollVote() there's nothing further to check once the
  // affected key is confirmed to be exactly the caller's own.
  function isReaction(before) {
    return request.resource.data.diff(before).affectedKeys().hasOnly(['reactions'])
      && request.resource.data.get('reactions', {}).diff(before.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]);
  }

  // True if a newly created message is a plain one posted by the caller —
  // never a `system` highlight (only the onMatchCreated Cloud Function posts
  // those, through the Admin SDK), and never born with someone's poll vote,
  // reaction or an `edited` flag already filled in.
  function isValidNewMessage() {
    return request.resource.data.authorId == request.auth.uid
      && !request.resource.data.keys().hasAny(['system', 'pollVotes', 'reactions', 'edited']);
  }

  function serverDoc(serverId) {
    return get(/databases/$(database)/documents/servers/$(serverId));
  }

  function isServerMember(serverData) {
    return request.auth.uid in serverData.memberIds;
  }

  function isServerAdmin(serverData) {
    return request.auth.uid == serverData.ownerId || request.auth.uid in serverData.get('adminIds', []);
  }

  function salonDoc(serverId, salonId) {
    return get(/databases/$(database)/documents/servers/$(serverId)/salons/$(salonId));
  }

  function isSalonMember(serverId, salonId) {
    return request.auth.uid in salonDoc(serverId, salonId).data.memberIds;
  }

  // True if this update touches `adminIds` — promoting/demoting an admin is
  // owner-only (see the `servers/{serverId}` update rule below), unlike
  // every other admin-manageable field on the doc.
  function changesAdminIds(before) {
    return request.resource.data.diff(before).affectedKeys().hasAny(['adminIds']);
  }

  // A shared, global catalog of ready-made games (including special-rules
  // ones, e.g. role-based Président) that any signed-in user can browse and
  // import into their own group's catalog. Admin-managed directly via the
  // Firebase console (console writes bypass these rules), not writable by
  // the app itself.
  match /gameLibrary/{gameId} {
    allow read: if signedIn();
    allow write: if false;
  }

  // Public profile — only what other players need to see (name, avatar
  // color). Fetchable one doc at a time by anyone signed in, never listed as
  // a collection. Private fields (e-mail, friends, FCM tokens) live in the
  // owner-only `private/account` doc below; accounts created before the
  // split move them there on their own (see
  // UsersRepository._migrateLegacyPrivateFields).
  //
  // TRANSITION: app versions from before the split still write `email`,
  // `friendIds` and `fcmTokens` here (sign-up, friends, push tokens), so the
  // create/update rule doesn't enforce !writesPrivateUserFields() yet. Add
  // it back once every installed app has the private-doc version and
  // tool/migrate_private_user_fields.js has run.
  function writesPrivateUserFields() {
    let changes = request.resource.data.diff(resource == null ? {} : resource.data);
    return changes.addedKeys().union(changes.changedKeys()).hasAny(['email', 'friendIds', 'fcmTokens']);
  }

  match /users/{uid} {
    allow get: if signedIn();
    allow list: if false;
    allow create, update: if signedIn() && request.auth.uid == uid;
    // Only the account itself can delete its own record (account deletion).
    allow delete: if signedIn() && request.auth.uid == uid;

    match /private/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }

  // Players added without a real account (see GuestsRepository). Anyone
  // signed in can create one (attributed to themselves) and fetch one by id,
  // same trust model as `users` — but never list them all.
  match /guests/{guestId} {
    allow get: if signedIn();
    allow list: if false;
    allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    allow update: if false;
    allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
  }

  // Lets "invite a friend by email" resolve an email to a uid: fetching one
  // exact address works, listing the collection (every user's e-mail) doesn't.
  // An entry can only be created for the caller's own sign-in e-mail, so no
  // one can claim someone else's address before they sign up.
  match /emailIndex/{email} {
    allow get: if signedIn();
    allow list: if false;
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.auth.token.email.lower() == email;
    allow update: if false;
    // Only the indexed account itself can remove its own email entry
    // (account deletion).
    allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }

  match /groups/{groupId} {
    allow read: if signedIn() && isMember(resource.data);

    allow create: if signedIn()
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.memberIds == [request.auth.uid];

    // The owner can change anything, as long as they stay a member and hand
    // ownership only to another member. Any other member is limited to
    // isMemberGroupEdit() (inviting, leaving, reassigning a guest, reopening
    // the QR window). A non-member can also update the doc if the write is
    // exactly a self-join (scanning someone's invite QR code). In every case
    // the owner can never be dropped from `memberIds`.
    allow update: if signedIn()
      && request.resource.data.ownerId in request.resource.data.memberIds
      && (
        (resource.data.ownerId == request.auth.uid)
        || (isMember(resource.data) && isMemberGroupEdit(resource.data))
        || isSelfJoin(resource.data)
      );

    // Only the group's own owner can delete it.
    allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

    match /games/{gameId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Blocked once the group is closed — see isClosed(): a closed group
      // stays fully readable but frozen against new catalog changes.
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /matches/{matchId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Any member can record or resume/correct a match (same trust model as
      // everything else here — a friend group, not a multi-tenant org).
      // Resuming preserves `createdAt`, `gameId` and `groupId` client-side;
      // nothing here needs to special-case that. Blocked once the group is
      // closed (see isClosed()).
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Whole-document rewrites (see `TournamentsRepository.updateTournament`)
      // cover both creating a tournament and recording every match result
      // against its bracket — same trust model as matches. Blocked once the
      // group is closed (see isClosed()).
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    // The group's discussion thread. Any member can post (attributed to
    // themselves) or read; an existing message can only be changed by a poll
    // vote (any member, see isPollVote()), a reaction (any member, see
    // isReaction()), or the author editing their own text (see
    // isMessageEdit()) — and only their own author can delete one.
    // Not gated behind `isClosed()` since chatting isn't "recording new
    // game data". Highlight messages (`system: true`, `authorId: 'system'`)
    // are posted by the `onMatchCreated` Cloud Function using the Admin SDK,
    // which bypasses these rules entirely — no client can create one itself,
    // since isValidNewMessage() rejects any `system` field.
    match /messages/{messageId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      allow create: if signedIn() && isMember(groupDoc(groupId).data)
        && isValidNewMessage();
      allow update: if signedIn() && isMember(groupDoc(groupId).data)
        && (isPollVote(resource.data) || isMessageEdit(resource.data) || isReaction(resource.data));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // A "match currently being scored" doc: created when someone starts
    // scoring (a Cloud Function picks that up to push a "Une partie de X a
    // été débutée" notice to the rest of the group), updated live as scores
    // change so the rest of the group can watch, and deleted once the match
    // is saved or scoring is abandoned. Only its author can update/delete it;
    // any member can read it to watch the match live.
    match /matchSessions/{sessionId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      allow create: if signedIn() && isMember(groupDoc(groupId).data)
        && request.resource.data.startedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.startedBy == request.auth.uid;
    }
  }

  match /servers/{serverId} {
    allow read: if signedIn() && isServerMember(resource.data);

    allow create: if signedIn()
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.memberIds == [request.auth.uid]
      && request.resource.data.get('adminIds', []) == [];

    // Roster/closed/invite-window changes: owner or admin. Promoting/
    // demoting an admin (`adminIds`) is further restricted to the owner
    // alone — an admin can't grant itself or anyone else more power. A
    // non-member can also self-join via QR (see isSelfJoin()), same pattern
    // as a Group.
    allow update: if signedIn() && (
      isSelfJoin(resource.data)
      || (resource.data.ownerId == request.auth.uid)
      || (isServerAdmin(resource.data) && !changesAdminIds(resource.data))
    );

    allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

    match /salons/{salonId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberIds || isServerAdmin(serverDoc(serverId).data)
      );
      // Only the server's owner/admins create or delete a salon — the whole
      // point of a Server over a Group is that this isn't a free-for-all.
      allow create, delete: if signedIn() && isServerAdmin(serverDoc(serverId).data);
      // Roster changes: admin, or a non-member self-joining via QR (see
      // ServersRepository.joinSalon — the matching server-membership write
      // happens as a separate update on the parent `servers/{serverId}` doc,
      // covered by isSelfJoin() there too).
      allow update: if signedIn() && (isSelfJoin(resource.data) || isServerAdmin(serverDoc(serverId).data));
    }

    match /games/{gameId} {
      allow read: if signedIn() && isServerMember(serverDoc(serverId).data);
      // Only owner/admins manage the catalog (vs. any member for a Group) —
      // and blocked once the server is closed, same as a Group.
      allow create, update: if signedIn() && isServerAdmin(serverDoc(serverId).data) && !isClosed(serverDoc(serverId).data);
      allow delete: if signedIn() && isServerAdmin(serverDoc(serverId).data);
    }

    match /matches/{matchId} {
      // A match belongs to exactly one salon (`salonId`); anyone who can see
      // that salon can see the match recorded in it.
      allow read: if signedIn() && (
        isSalonMember(serverId, resource.data.salonId) || isServerAdmin(serverDoc(serverId).data)
      );
      // Any salon member can record or edit a match in it — same trust model
      // as a Group's matches (this app doesn't try to enforce the
      // confirm/reject workflow itself at the rules layer; the client only
      // ever calls confirmMatch/rejectMatch through vetted paths — see
      // AppState.confirmMatch/rejectMatch). Blocked once the server or the
      // specific salon is closed.
      allow create, update: if signedIn()
        && isSalonMember(serverId, request.resource.data.salonId)
        && !isClosed(serverDoc(serverId).data)
        && !isClosed(salonDoc(serverId, request.resource.data.salonId).data);
      // Only owner/admins delete a match — the last-resort way to resolve a
      // contested one (see AppState.canForceResolveMatch).
      allow delete: if signedIn() && isServerAdmin(serverDoc(serverId).data);
    }

    // A discussion thread scoped by `salonId` (see the data model recap
    // above) — same trust model as a Group's `messages`: any salon member
    // can post (attributed to themselves) or read; an existing message can
    // only be changed by a poll vote (isPollVote()), a reaction
    // (isReaction()), or the author editing their own text (isMessageEdit()),
    // and only their own author can delete one.
    match /messages/{messageId} {
      allow read: if signedIn() && (
        isSalonMember(serverId, resource.data.salonId) || isServerAdmin(serverDoc(serverId).data)
      );
      allow create: if signedIn()
        && isSalonMember(serverId, request.resource.data.salonId)
        && isValidNewMessage();
      allow update: if signedIn() && isSalonMember(serverId, resource.data.salonId)
        && (isPollVote(resource.data) || isMessageEdit(resource.data) || isReaction(resource.data));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
}
