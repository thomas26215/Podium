rules_version = '2';

// Security rules for Podium.
//
// Deploy with: firebase deploy --only firestore:rules
// (after `firebase init firestore` / `firebase use <your-project>`).
//
// Data model recap:
//   users/{uid}                        one doc per account
//   guests/{guestId}                   one doc per account-less player, added
//                                       into `memberIds` as a `guest:{guestId}`
//                                       string (see GuestsRepository)
//   emailIndex/{lowercasedEmail}        {uid} — lets "invite by email" find a uid
//   groups/{groupId}                   a friend group
//   groups/{groupId}/games/{gameId}    game catalog
//   groups/{groupId}/matches/{matchId} recorded matches
//   groups/{groupId}/tournaments/{id}  a bracket (single/double elimination or
//                                       groups+elimination) — the whole bracket
//                                       (every match node) lives embedded in
//                                       this one document

service cloud.firestore {
match /databases/{database}/documents {

  function signedIn() {
    return request.auth != null;
  }

  function isMember(groupData) {
    return request.auth.uid in groupData.memberIds;
  }

  function groupDoc(groupId) {
    return get(/databases/$(database)/documents/groups/$(groupId));
  }

  // True if the caller owns group `groupId` — used to gate destructive
  // actions (deleting the group, its games/matches, …).
  function isGroupOwner(groupId) {
    return groupDoc(groupId).data.ownerId == request.auth.uid;
  }

  // True for a wound-down "temporary group" (see Group.closed) — its
  // history stays readable but nothing new gets recorded in it.
  function isClosed(groupData) {
    return groupData.get('closed', false) == true;
  }

  // True while `groupData`'s QR self-join window is open (see
  // Group.inviteExpiresAt / GroupsRepository.refreshInviteWindow, refreshed
  // every time the invite dialog's QR tab is shown). A group that has never
  // opened a window (the field is simply absent — every group created before
  // this existed, or one that's never shown its QR tab) stays joinable
  // unconditionally, so this only ever *tightens* behavior for groups that
  // opt in by generating a code, never breaks existing ones on deploy.
  function inviteWindowOpen(groupData) {
    return !('inviteExpiresAt' in groupData) || request.time < groupData.inviteExpiresAt;
  }

  // True if this update only adds the caller's own uid to `memberIds`
  // (nothing else touched) — the shape of a self-service QR invite join.
  // It's a write-only check: a non-member can perform it without ever being
  // able to `read` the doc first, since the QR code itself already carries
  // everything the client needs (see GroupInviteCode). Also requires the
  // invite window to still be open, so a screenshot/photo of an old code
  // can't be replayed forever — see inviteWindowOpen().
  function isSelfJoin(before) {
    let addedMembers = request.resource.data.memberIds.removeAll(before.memberIds);
    return request.resource.data.diff(before).affectedKeys().hasOnly(['memberIds'])
      && request.resource.data.memberIds.removeAll([request.auth.uid]) == before.memberIds
      && addedMembers.size() > 0
      && inviteWindowOpen(before);
  }

  // A shared, global catalog of ready-made games (including special-rules
  // ones, e.g. role-based Président) that any signed-in user can browse and
  // import into their own group's catalog. Admin-managed directly via the
  // Firebase console (console writes bypass these rules), not writable by
  // the app itself.
  match /gameLibrary/{gameId} {
    allow read: if signedIn();
    allow write: if false;
  }

  match /users/{uid} {
    allow read: if signedIn();
    allow create: if signedIn() && request.auth.uid == uid;
    allow update: if signedIn() && request.auth.uid == uid;
    // Only the account itself can delete its own record (account deletion).
    allow delete: if signedIn() && request.auth.uid == uid;
  }

  // Lets "invite a friend by email" resolve an email to a uid without
  // exposing the whole users collection to arbitrary queries.
  // Players added without a real account (see GuestsRepository). Anyone
  // signed in can create one (attributed to themselves) and read them all,
  // same trust model as `users` — a friend group, not a multi-tenant org.
  match /guests/{guestId} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    allow update: if false;
    allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
  }

  match /emailIndex/{email} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    allow update: if false;
    // Only the indexed account itself can remove its own email entry
    // (account deletion).
    allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }

  match /groups/{groupId} {
    allow read: if signedIn() && isMember(resource.data);

    allow create: if signedIn()
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.memberIds == [request.auth.uid];

    // Any member can manage the roster (invite by email = arrayUnion on
    // memberIds) — this app's trust model is a friend group, not a
    // multi-tenant org, so we don't gate management down to an "admin" role.
    // A non-member can also update the doc if the write is exactly a
    // self-join (scanning someone's invite QR code).
    allow update: if signedIn() && (isMember(resource.data) || isSelfJoin(resource.data));

    // Only the group's own owner can delete it.
    allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

    match /games/{gameId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Blocked once the group is closed — see isClosed(): a closed group
      // stays fully readable but frozen against new catalog changes.
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /matches/{matchId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Any member can record or resume/correct a match (same trust model as
      // everything else here — a friend group, not a multi-tenant org).
      // Resuming preserves `createdAt`, `gameId` and `groupId` client-side;
      // nothing here needs to special-case that. Blocked once the group is
      // closed (see isClosed()).
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      // Whole-document rewrites (see `TournamentsRepository.updateTournament`)
      // cover both creating a tournament and recording every match result
      // against its bracket — same trust model as matches. Blocked once the
      // group is closed (see isClosed()).
      allow create, update: if signedIn() && isMember(groupDoc(groupId).data) && !isClosed(groupDoc(groupId).data);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    // A "match currently being scored" doc: created when someone starts
    // scoring (a Cloud Function picks that up to push a "Une partie de X a
    // été débutée" notice to the rest of the group), updated live as scores
    // change so the rest of the group can watch, and deleted once the match
    // is saved or scoring is abandoned. Only its author can update/delete it;
    // any member can read it to watch the match live.
    match /matchSessions/{sessionId} {
      allow read: if signedIn() && isMember(groupDoc(groupId).data);
      allow create: if signedIn() && isMember(groupDoc(groupId).data)
        && request.resource.data.startedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.startedBy == request.auth.uid;
    }
  }
}
}
